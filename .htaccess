# ============================================================
#  Takees Marketing — Hostinger Shared Hosting Configuration
#  Place this file in public_html/ (project root)
# ============================================================

# ----------------------------------------------------------
#  Charset & MIME Types
# ----------------------------------------------------------
AddDefaultCharset UTF-8

# ----------------------------------------------------------
#  Home Page
#  Only index.html is used as a folder's home page (no PHP)
# ----------------------------------------------------------
DirectoryIndex index.html

AddType image/svg+xml .svg
AddType image/webp    .webp
AddType font/woff2    .woff2
AddType font/woff     .woff

# ----------------------------------------------------------
#  Compression (Gzip)
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------
#  Browser Caching
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short cache (content changes)
  ExpiresByType text/html                 "access plus 1 hour"

  # CSS & JS — medium cache
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"

  # Images — long cache
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ----------------------------------------------------------
#  Location Pages (single folder)
#  bangalore.html and kochi.html live in the root and are served
#  at takees.in/bangalore and takees.in/kochi (no trailing slash,
#  so their relative css/js/asset paths resolve to the root)
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Visiting /bangalore.html or /kochi.html directly → the clean address
  RewriteCond %{THE_REQUEST} \s/+(bangalore|kochi)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # Old folder addresses: /bangalore/ and /bangalore/index.html → /bangalore
  RewriteRule ^(bangalore|kochi)/(index\.html)?$ /$1 [R=301,L]

  # Old folder pages (about, services, method, …) → the shared root page
  RewriteRule ^(?:bangalore|kochi)/([a-z-]+\.html)$ /$1 [R=301,L]

  # Serve the clean address from the root file
  RewriteRule ^(bangalore|kochi)$ /$1.html [L]
</IfModule>

# ----------------------------------------------------------
#  Custom 404 Error Page
# ----------------------------------------------------------
# ErrorDocument 404 /404.html

# ----------------------------------------------------------
#  Security Headers
# ----------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Basic XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------
#  Prevent access to hidden/dot files
# ----------------------------------------------------------
<FilesMatch "^\\.">
  Order allow,deny
  Deny from all
</FilesMatch>
